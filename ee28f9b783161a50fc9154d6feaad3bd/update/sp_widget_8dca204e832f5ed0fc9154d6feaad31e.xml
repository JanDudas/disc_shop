        <script><![CDATA[(function() {
	/* populate the 'data' object */
	/* e.g., data.table = $sp.getValue('table'); */

	data.bmwDiscs = [];
	var bmwDiscsGR = new GlideRecord('x_1461179_disk_sho_disc_bmw_admin');
	/// vloz x_1461179_disk_sho_disc_bmw_admin bolo
	bmwDiscsGR.orderByDesc('sys_created_on');	
	bmwDiscsGR.query();	 

	while(bmwDiscsGR.next()){
		var discObj = {};
		$sp.getRecordDisplayValues(discObj,bmwDiscsGR,'u_mark, u_modell, u_performance,	u_count, u_price, u_priceallpcs');
		data.bmwDiscs.push(discObj);
	}

	if(input){
		var allDiscsGR = new GlideRecord('x_1461179_disk_sho_disc_bmw_admin');
		if(input.action =='displayAll'){
			data.scVars =	$sp.getRecordVariablesArray(allDiscsGR); 

		}
	}
})();]]></script>
